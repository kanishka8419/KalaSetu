# =============================================================================
# KalaSetu Backend — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kalasetu
# For SQLite fallback (development): sqlite+aiosqlite:///./kalasetu.db

# --- JWT Auth ---
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Services (set USE_MOCK_AI=true to skip real models) ---
USE_MOCK_AI=true

# Gemini API (optional if USE_MOCK_AI=true)
GEMINI_API_KEY=your-gemini-api-key

# --- Cloudinary (optional if USE_MOCK_AI=true) ---
USE_MOCK_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Maps API (optional, defaults to mock) ---
USE_MOCK_MAPS=true
MAPS_API_KEY=your-maps-api-key

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
